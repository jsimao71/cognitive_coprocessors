{"annotations":[{"dataset":"gsm_plus","source_id":"gsm-plus-05402","annotator":"codex","answer_hidden":true,"rationale_hidden":true,"rationale_assisted":false,"repair_round":0,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":[],"semantic_notes":["Establishes the shelter context and James's qualitative need; no new quantitative fact is stated."],"assumptions":[],"confidence":0.98},{"part_id":1,"status":"ok","asl":["shelter.toys_per_dog = 1"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["james.toys_on_hand = 4","shelter.initial_dogs = 4","shelter.first_arrival.additional_dogs = 10 * 4 / 5","shelter.after_first_arrival.dogs = shelter.initial_dogs + shelter.first_arrival.additional_dogs"],"semantic_notes":["The four dogs are distinguished from the additional dogs now in the shelter."],"assumptions":[],"confidence":0.96},{"part_id":3,"status":"ok","asl":["james.first_purchase.toys = shelter.first_arrival.additional_dogs * shelter.toys_per_dog","shelter.second_arrival.additional_dogs = shelter.first_arrival.additional_dogs * 2","james.second_purchase.toys = shelter.second_arrival.additional_dogs * shelter.toys_per_dog"],"semantic_notes":["The two purchases remain separate so later departures can reduce the cumulative additional-toy requirement."],"assumptions":["Interprets \"twice as many more dogs than when he left\" as a second group of additional dogs twice the size of the first additional group."],"confidence":0.72},{"part_id":4,"status":"ok","asl":["shelter.third_visit.dogs_gone = 10 * 3 / 10","james.toys_no_longer_needed = shelter.third_visit.dogs_gone * shelter.toys_per_dog"],"semantic_notes":[],"assumptions":["Each departing dog eliminates the need for one of the additional toys."],"confidence":0.94},{"part_id":5,"status":"ok","asl":["james.total_additional_toys_needed = james.first_purchase.toys + james.second_purchase.toys - james.toys_no_longer_needed","RETURN james.total_additional_toys_needed"],"semantic_notes":["The returned quantity is the net number of additional toys James needs to obtain, excluding the four already on hand."],"assumptions":["The question inherits the opening goal of getting more toys, so \"toys in total\" refers to the net additional toys rather than all toys in the shelter."],"confidence":0.8}]},{"dataset":"gsm_plus","source_id":"gsm-plus-03370","annotator":"codex","answer_hidden":true,"rationale_hidden":true,"rationale_assisted":false,"repair_round":0,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":["rock.cats.initial = 150 / 3"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["boats.count = 4","boats.cats_carried_each = 5","rock.cats.carried_away = boats.count * boats.cats_carried_each","rock.cats.after_boats = rock.cats.initial - rock.cats.carried_away","rock.cats.chased_mouse = rock.cats.after_boats * 0.6","rock.cats.left = rock.cats.after_boats - rock.cats.chased_mouse"],"semantic_notes":["The cats that chased the mouse are measured from the population remaining after the boats departed."],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["RETURN rock.cats.left"],"semantic_notes":[],"assumptions":[],"confidence":0.99}]},{"dataset":"gsm_plus","source_id":"gsm-plus-06614","annotator":"codex","answer_hidden":true,"rationale_hidden":true,"rationale_assisted":false,"repair_round":0,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":[],"semantic_notes":["Establishes the event context without introducing a quantitative fact."],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["cindy.chocolate_bunnies = 5"],"semantic_notes":["Chocolate bunnies are recorded separately from eggs and are not included in the requested egg total."],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["cindy.eggs.green = 5","cindy.eggs.blue = cindy.eggs.green * 2","cindy.eggs.pink = cindy.eggs.blue - 1"