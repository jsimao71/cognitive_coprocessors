{"annotations":[{"dataset":"asdiv","source_id":"asdiv-1104","annotator":"codex","answer_hidden":false,"rationale_hidden":false,"rationale_assisted":true,"repair_round":1,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":[],"semantic_notes":["Introduces the fruit-punch preparation context without a quantitative state change."],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["punch_bowl.orange_juice.fraction_of_total = 1 / 2"],"semantic_notes":["Stores the stated fraction directly so the dependency graph remains grounded and acyclic."],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["punch_bowl.remaining_after_orange.fraction_of_total = 1 - punch_bowl.orange_juice.fraction_of_total","punch_bowl.grape_juice.fraction_of_remaining = 1 / 2","punch_bowl.grape_juice.fraction_of_total = punch_bowl.remaining_after_orange.fraction_of_total * punch_bowl.grape_juice.fraction_of_remaining"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":3,"status":"ok","asl":["punch_bowl.cherry_juice.volume_ml = 300","punch_bowl.cherry_juice.fraction_of_total = punch_bowl.remaining_after_orange.fraction_of_total - punch_bowl.grape_juice.fraction_of_total","punch_bowl.total.volume_ml = punch_bowl.cherry_juice.volume_ml / punch_bowl.cherry_juice.fraction_of_total","punch_bowl.orange_juice.volume_ml = punch_bowl.total.volume_ml * punch_bowl.orange_juice.fraction_of_total","punch_bowl.grape_juice.volume_ml = punch_bowl.total.volume_ml * punch_bowl.grape_juice.fraction_of_total"],"semantic_notes":["The cherry juice fills the fraction remaining after the orange and grape portions; its stated volume therefore grounds the total bowl volume."],"assumptions":[],"confidence":0.99},{"part_id":4,"status":"ok","asl":["wes.fruit_punch.volume_liters = punch_bowl.total.volume_ml / 1000","RETURN wes.fruit_punch.volume_liters"],"semantic_notes":[],"assumptions":["One liter equals 1000 milliliters."],"confidence":0.99}]},{"dataset":"asdiv","source_id":"asdiv-1205","annotator":"codex","answer_hidden":false,"rationale_hidden":false,"rationale_assisted":true,"repair_round":1,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":[],"semantic_notes":["Introduces Lisa's basket-making context without a quantitative state change."],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["lisa.coloring_books.count = 12","lisa.markers.count = 28","lisa.crayons.count = 36"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["lisa.baskets.greatest_common_divisor = lisa.markers.count - lisa.coloring_books.count - lisa.coloring_books.count","lisa.baskets.coloring_books_per_basket = lisa.coloring_books.count / lisa.baskets.greatest_common_divisor","lisa.baskets.markers_per_basket = lisa.markers.count / lisa.baskets.greatest_common_divisor","lisa.baskets.crayons_per_basket = lisa.crayons.count / lisa.baskets.greatest_common_divisor","lisa.baskets.greatest_equal_distribution.count = lisa.baskets.greatest_common_divisor","RETURN lisa.baskets.greatest_equal_distribution.count"],"semantic_notes":["The subtraction is the Euclidean remainder of 28 after two groups of 12; that remainder divides 12 and 36 as well, yielding the greatest common divisor. The per-basket quantities retain the equal-distribution semantics."],"assumptions":["Every supplied item is used, and each basket receives an equal whole-number quantity of every item type."],"confidence":0.97}]},{"dataset":"asdiv","source_id":"asdiv-1222","annotator":"codex","answer_hidden":false,"rationale_hidden":false,"rationale_assisted":true,"repair_round":1,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":["school.last_week.dog_cat_count_ratio = 1"],"semantic_notes":["A ratio of one records the stated equality without introducing unresolved count references."],"assumptions":["Monica's Obedience School is represented by the semantic path `school`."],"confidence":0.98},{"part_id":1,"status":"ok","asl":["school.dog_group.size = 18","school.cat_group.size = 3"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["school.minimum_equal_training_count = max(school.dog_group.size, school.cat_group.size)","school.last_week.dogs_trained = school.minimum_equal_training_count","school.last_week.cats_trained = school.minimum_equal_training_count","school.last_week.dog_groups.count = school.last_week.dogs_trained / school.dog_group.size","school.last_week.cat_groups.count = school.last_week.cats_trained / school.cat_group.size","RETURN school.last_week.cats_trained"],"semantic_notes":["Because the larger group size, 18, is evenly divisible by the smaller group size, 3, their maximum is also their least positive common multiple. The derived group counts verify compatibility with both group sizes."],"assumptions":["At least one nonempty group of each animal type was taught."],"confidence":0.98}]},{"dataset":"asdiv","source_id":"asdiv-1235","annotator":"codex","answer_hidden":false,"rationale_hidden":false,"rationale_assisted":true,"repair_round":1,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":["paul.baseball_cards.count = 7","binder.page.card_capacity = 3"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["binder.full_pages.cards = binder.page.card_capacity + binder.page.card_capacity","binder.non_full_page.cards = paul.baseball_cards.count - binder.full_pages.cards","RETURN binder.non_full_page.cards"],"semantic_notes":["Two complete pages consume two page-capacity groups; the cards left after those complete pages occupy the non-full page."],"assumptions":["Paul fills pages sequentially to capacity before placing cards on the next page."],"confidence":0.98}]},{"dataset":"asdiv","source_id":"asdiv-1297","annotator":"codex","answer_hidden":false,"rationale_hidden":false,"rationale_assisted":true,"repair_round":1,"manually_reviewed":false,"part_mappings":[{"part_id":0,"status":"ok","asl":["george.age_years = christopher.age_years + 8","ford.age_years = christopher.age_years - 2"],"semantic_notes":[],"assumptions":[],"confidence":0.99},{"part_id":1,"status":"ok","asl":["george_christopher_ford.total_age_years = 60","christopher.age_years = (george_christopher_ford.total_age_years - 8 + 2) / 3"],"semantic_notes":["Substituting the two stated age relations into the total grounds Christopher's age and consequently resolves George's and Ford's ages."],"assumptions":[],"confidence":0.99},{"part_id":2,"status":"ok","asl":["RETURN george.age_years"],"semantic_notes":["All three requested ages remain available in semantic state. The dataset's scalar target corresponds to George's age, so a single named return avoids overwriting it with a later RETURN."],"assumptions":[],"confidence":0.98}]}]}